# ==============================================================================
# JobAlert Environment Configuration
# ==============================================================================

# Application Environment
ENV=development
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Email Providers (Choose one in config/jobs.yaml: resend, brevo, sendgrid, smtp)
# ------------------------------------------------------------------------------
# Resend (Default free tier: 3,000 emails/mo) - https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Brevo (formerly Sendinblue - 300 free emails/day) - https://brevo.com
BREVO_API_KEY=xkeysib-your_api_key_here

# SendGrid (100 free emails/day) - https://sendgrid.com
SENDGRID_API_KEY=SG.your_api_key_here

# Custom SMTP (e.g. Gmail App Password, AWS SES, Mailgun, Postmark)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# Delivery Recipients & Sender Defaults
# ------------------------------------------------------------------------------
CANDIDATE_EMAIL=candidate@example.com
ALERTS_FROM_EMAIL=Job Intelligence <alerts@resend.dev>

# ------------------------------------------------------------------------------
# Optional Cloud Database State (Supabase / Postgres)
# If left unset, JobsAlert defaults to local/git-synced data/seen_jobs.json
# ------------------------------------------------------------------------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=eyJhbGciOi...
