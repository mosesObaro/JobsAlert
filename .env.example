# ==============================================================================
# JobsAlert environment configuration (copy to .env; never commit .env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Email providers — choose one with delivery.email_provider in config/jobs.yaml
# (resend, brevo, sendgrid, smtp, or console for preview-only)
# ------------------------------------------------------------------------------
# Resend (free tier: 3,000 emails/month) - https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Brevo (free tier: 300 emails/day) - https://brevo.com
BREVO_API_KEY=xkeysib-your_api_key_here

# SendGrid (free tier: 100 emails/day) - https://sendgrid.com
SENDGRID_API_KEY=SG.your_api_key_here

# SMTP (e.g. a Gmail app password). Port 465 uses implicit TLS; other ports use STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# Delivery overrides. These replace the values in config/jobs.yaml at runtime and
# are never written back to it when you save settings from the dashboard.
# ------------------------------------------------------------------------------
CANDIDATE_EMAIL=candidate@example.com
ALERTS_FROM_EMAIL=Job Intelligence <alerts@resend.dev>
# EMAIL_PROVIDER=console

# ------------------------------------------------------------------------------
# Control panel server (python run.py --server)
# ------------------------------------------------------------------------------
# Required when listening on anything other than 127.0.0.1 (--host). On this machine
# the dashboard fetches a per-session token automatically.
# JOBSALERT_API_TOKEN=use-a-long-random-value
# Extra host names/origins to accept (comma separated), e.g. when using --host 0.0.0.0
# JOBSALERT_ALLOWED_HOSTS=my-laptop.local
# JOBSALERT_CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# Paths (optional; mainly for tests and CI)
# ------------------------------------------------------------------------------
# JOBSALERT_DATA_DIR=data
# JOBSALERT_CONFIG=config/jobs.yaml
# JOBSALERT_PROFILES_DIR=config/profiles
